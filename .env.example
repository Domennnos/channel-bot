# Это ОБРАЗЕЦ. Скопируйте его в файл с именем .env и впишите свои значения.
# (Файл .env никуда не отправляется — он в .gitignore.)

# Токен бота от @BotFather (выглядит как 123456789:AAxxxxxxxx)
TELEGRAM_BOT_TOKEN=

# Ключ Anthropic API (начинается с sk-ant-)
ANTHROPIC_API_KEY=

# Ваш личный Telegram-ID (число). Узнать: напишите боту /start — он его покажет.
OWNER_ID=

# Канал: @имя_канала (если публичный) или число вида -1001234567890
CHANNEL_ID=

# Чат обсуждения канала (для комментариев). Можно оставить пустым.
DISCUSSION_CHAT_ID=
